<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_t08" targetNamespace="http://bpmn-editor.test/t08">
  <process id="Process_t08" isExecutable="false">
    <startEvent id="Start_1" name="Message received">
      <outgoing>Flow_1</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1" />
    </startEvent>
    <task id="Task_1" name="Process message">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <intermediateCatchEvent id="Intermediate_Timer" name="Wait">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
      <timerEventDefinition id="TimerEventDefinition_1" />
    </intermediateCatchEvent>
    <endEvent id="End_1" name="Terminate">
      <incoming>Flow_3</incoming>
      <terminateEventDefinition id="TerminateEventDefinition_1" />
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Task_1" />
    <sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Intermediate_Timer" />
    <sequenceFlow id="Flow_3" sourceRef="Intermediate_Timer" targetRef="End_1" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_t08">
    <bpmndi:BPMNPlane id="Plane_t08" bpmnElement="Process_t08">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
        <omgdc:Bounds x="100" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <omgdc:Bounds x="220" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Intermediate_Timer_di" bpmnElement="Intermediate_Timer">
        <omgdc:Bounds x="400" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <omgdc:Bounds x="520" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="136" y="140" />
        <omgdi:waypoint x="220" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="320" y="140" />
        <omgdi:waypoint x="400" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="436" y="140" />
        <omgdi:waypoint x="520" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
