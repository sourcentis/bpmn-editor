    <sequenceFlow id="Flow_3" sourceRef="Task_Bioc" targetRef="Task_Plain" />
    <sequenceFlow id="Flow_4" sourceRef="Task_Plain" targetRef="End_1" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_t09">
    <bpmndi:BPMNPlane id="Plane_t09" bpmnElement="Process_t09">
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1">
