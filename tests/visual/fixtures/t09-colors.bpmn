<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_t09" targetNamespace="http://bpmn-editor.test/t09">
  <process id="Process_t09" isExecutable="false">
    <startEvent id="Start_1" name="Start">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Task_Omg" name="OMG colored">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <task id="Task_Bioc" name="Bioc colored">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>
    <task id="Task_Plain" name="No color">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
    </task>
