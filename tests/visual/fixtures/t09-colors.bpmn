      <bpmndi:BPMNShape id="Task_Bioc_di" bpmnElement="Task_Bioc" bioc:fill="#bbf7d0" bioc:stroke="#065f46">
        <omgdc:Bounds x="340" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Plain_di" bpmnElement="Task_Plain">
        <omgdc:Bounds x="500" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <omgdc:Bounds x="660" y="142" width="36" height="36" />
