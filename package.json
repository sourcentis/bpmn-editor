{
  "name": "@sourcentis/bpmn-editor",
  "version": "1.10.0",
  "description": "BPMN diagram editor, agnostic of UI framework and backend, built on @maxgraph/core",
  "type": "module",
  "main": "./dist/bpmn-editor.umd.cjs",
  "module": "./dist/bpmn-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bpmn-editor.js",
      "require": "./dist/bpmn-editor.umd.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "serve": "http-server . -p 8000 -c-1 -o /examples/",
    "test": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:structural": "playwright test tests/structural",
    "test:visual:update": "playwright test tests/visual --update-snapshots"
  },
  "peerDependencies": {
    "@maxgraph/core": "^0.21.0"
  },
  "devDependencies": {
    "@maxgraph/core": "^0.21.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.43",
    "http-server": "^14.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.0"
  },
  "keywords": [
    "bpmn",
    "diagram",
    "editor",
    "maxgraph",
    "workflow",
    "cartography"
  ],
  "license": "GPL-3.0",
  "author": "Didier Barzin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcentis/bpmn-editor.git"
  },
  "bugs": {
    "url": "https://github.com/sourcentis/bpmn-editor/issues"
  },
  "homepage": "https://github.com/sourcentis/bpmn-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "ajv": "^8.18.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "alien-signals": "^0.4.14",
    "argparse": "^1.0.10",
    "balanced-match": "^4.0.4",
    "brace-expansion": "^5.0.9",
    "compare-versions": "^6.1.1",
    "confbox": "^0.2.4",
    "de-indent": "^1.0.2",
    "debug": "^4.4.3",
    "detect-libc": "^2.1.2",
    "diff": "^8.0.4",
    "entities": "^7.0.1",
    "es-errors": "^1.3.0",
    "estree-walker": "^2.0.2",
    "exsolve": "^1.1.1",
    "fast-deep-equal": "^3.1.3",
    "fast-uri": "^3.1.5",
    "fdir": "^6.5.0",
    "fs-extra": "^11.3.6",
    "function-bind": "^1.1.2",
    "graceful-fs": "^4.2.11",
    "has-flag": "^4.0.0",
    "hasown": "^2.0.4",
    "he": "^1.2.0",
    "import-lazy": "^4.0.0",
    "is-core-module": "^2.16.2",
    "jju": "^1.4.0",
    "json-schema-traverse": "^1.0.0",
    "jsonfile": "^6.2.1",
    "kolorist": "^1.8.0",
    "lightningcss": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "local-pkg": "^1.2.1",
    "magic-string": "^0.30.21",
    "minimatch": "^10.2.3",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "muggle-string": "^0.4.1",
    "nanoid": "^3.3.18",
    "path-browserify": "^1.0.1",
    "path-parse": "^1.0.7",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "pkg-types": "^2.3.1",
    "postcss": "^8.5.26",
    "quansync": "^0.2.11",
    "require-from-string": "^2.0.2",
    "resolve": "^1.22.12",
    "rolldown": "^1.2.3",
    "semver": "^7.7.4",
    "source-map": "^0.6.1",
    "source-map-js": "^1.2.1",
    "sprintf-js": "^1.0.3",
    "string-argv": "^0.3.2",
    "supports-color": "^8.1.1",
    "supports-preserve-symlinks-flag": "^1.0.0",
    "tinyglobby": "^0.2.17",
    "ufo": "^1.6.4",
    "universalify": "^2.0.1",
    "vscode-uri": "^3.1.0"
  }
}
